# Shared secret. The server only answers requests that carry it in the
# X-API-Key header. `make server` and `make client` generate one for you the
# first time they run; to watch a remote server, copy its key into SERVERS below.
API_KEY=

# Port the server listens on.
SERVER_PORT=8000

# Port the dashboard is served on.
CLIENT_PORT=3000

# Servers the dashboard watches, separated by commas, each as name|url|api-key.
# Leave unset to watch the server started by `make server` on this machine.
# SERVERS=Web|http://10.0.0.5:8000|key-one,Database|http://10.0.0.6:8000|key-two

# How often the dashboard refreshes, in seconds.
REFRESH_SECONDS=5
